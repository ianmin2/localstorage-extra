  "description": "A lightweight, type-safe localStorage utility with advanced querying, filtering, cross-tab communication, and storage monitoring",
  "keywords": ["localStorage", "storage", "browser", "typescript", "utility", "cross-tab", "events"],
  "repository": {
    "type": "git",
